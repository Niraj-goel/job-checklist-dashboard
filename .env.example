# Job Checklist Dashboard settings. Copy to .env for a local run; on the host enter the same names as environment variables.
# Without a Checklist/.env, a local run also reads the project's root .env (the Company Master key).

PORT=3000

# Job Checklist DB.xlsx in Google Drive (also holds the user list, requests and change log)
CHECKLIST_FILE_ID=1bmgjKdSf6zITxFC6A6omZLQ6pdMi0oma

# Google service account (share the workbook with this address as Editor)
GOOGLE_CLIENT_EMAIL=company-master-dashboard@company-master-dashboard.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=

# Optional break-glass admin sign-in (email + password), never stored in the workbook
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional: hours a sign-in lasts (default 12)
SESSION_HOURS=12
