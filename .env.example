# Job Checklist Dashboard settings. Copy to .env for a local run; on Render enter the same names under Environment.
# Without a Checklist/.env, a local run also reads the project's root .env (the Company Master key).

PORT=3000

# Sign-in. The editor can change tasks; the viewer (optional) can only look and download reports.
DASHBOARD_USER=alcove
DASHBOARD_PASSWORD=
VIEWER_USER=viewer
VIEWER_PASSWORD=

# Job Checklist DB.xlsx in Google Drive
CHECKLIST_FILE_ID=1bmgjKdSf6zITxFC6A6omZLQ6pdMi0oma

# Google service account (share the workbook with this address as Editor)
GOOGLE_CLIENT_EMAIL=company-master-dashboard@company-master-dashboard.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=
